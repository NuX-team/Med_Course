# The server's settings. Copy to `.env.production` ON THE SERVER (never commit it, never paste its
# values in chat or into a ticket) and fill every line. docs/PILOT.md says where each value comes from.

# --- Addresses (two names pointing at this server's IP, before the first start) ---
BOT_HOST=bot.example.uz
PANEL_HOST=panel.example.uz
PUBLIC_BASE_URL=https://bot.example.uz
PANEL_BASE_URL=https://panel.example.uz
# Let's Encrypt writes here when a certificate is about to expire.
ACME_EMAIL=admin@example.uz

# --- Database (internal only; any long random password) ---
POSTGRES_USER=medcourse
POSTGRES_PASSWORD=
POSTGRES_DB=medcourse

# --- Secrets: each one is made once, kept in a password manager and ALSO away from this server ---
# "<id>:<base64 of 32 random bytes>"; ids must not start with "dev".
#   node -e "console.log('prod1:'+require('crypto').randomBytes(32).toString('base64'))"
# Lose this and the patients' encrypted fields cannot be read, even from a backup.
ENCRYPTION_KEYS=
# Seals the backup files. A DIFFERENT key from the one above (the preflight checks).
BACKUP_KEY=
# From @BotFather, of the bot patients will use (not the test bot).
TELEGRAM_BOT_TOKEN=
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
TELEGRAM_WEBHOOK_SECRET=
# Whoever holds it can read the queue numbers at the worker's /metrics. Any long random string.
METRICS_TOKEN=

# --- Optional ---
LOG_LEVEL=info
# Server time (UTC) of the daily backup, and how many files to keep.
BACKUP_AT=03:00
BACKUP_KEEP=14
