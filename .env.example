# Local development. Copy to .env (git-ignored). Every value below is a local-only default.

APP_ENV=local
LOG_LEVEL=info


# Used by `pnpm dev:bot` / `pnpm dev:worker` against `docker compose up -d postgres`.
DATABASE_URL=postgres://medcourse:medcourse@localhost:5433/medcourse

# Application-level encryption ring: "<id>:<base64 of 32 random bytes>", comma-separated.
# The FIRST key encrypts, all keys decrypt (rotate by prepending a new key).
# This one is a throwaway local key; ids starting with "dev" are rejected outside APP_ENV=local.
# Generate a real one: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEYS=dev1:V4utw/HLyM+4n8fMSsURXViNYbg7eI5EGnlVKqaLGa0=

# Used by docker-compose.yml to create the local database.
POSTGRES_USER=medcourse
POSTGRES_PASSWORD=medcourse
POSTGRES_DB=medcourse
POSTGRES_HOST_PORT=5433

# HTTP_PORT is deliberately not set here: bot defaults to 3000, worker to 3001, panel to 3002.

# --- Telegram (the bot receives updates; the worker sends reminders with the same token) ---
# Create a bot with @BotFather and put its token here. Never commit it and never paste it in chat.
# Use a separate test bot for development: it keeps real patients out of your experiments.
TELEGRAM_BOT_TOKEN=

# With APP_ENV=local the bot asks Telegram for updates (polling): no public address needed.
# Every other environment uses a webhook, which needs the two values below.
# TELEGRAM_MODE=polling
# 16-256 characters from A-Z a-z 0-9 _ -  (node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))")
# TELEGRAM_WEBHOOK_SECRET=
# The https:// address Telegram can reach, without a path.
# PUBLIC_BASE_URL=

# --- Staff panel (apps/panel) ---
# The address staff open the panel at, without a path. The bot builds sign-in links from it
# (a member of staff sends /panel to the bot). https:// everywhere except APP_ENV=local.
# PANEL_BASE_URL=http://localhost:3002

# --- Backups (pnpm db:backup <directory>, pnpm db:restore-drill <file>) ---
# What backup files are encrypted with: "<id>:<base64 of 32 random bytes>". A secret of its own:
# it must NOT be one of ENCRYPTION_KEYS, and it is kept apart from the backups themselves.
# Without it (and the ENCRYPTION_KEYS of the data) a backup cannot be read by anyone, you included.
# Generate: node -e "console.log('backup1:'+require('crypto').randomBytes(32).toString('base64'))"
# BACKUP_KEY=

# --- Watching the service ---
# The worker's /metrics page (queue depths and ages, delay of a reminder, open incidents; numbers
# only, nothing about anybody). Whoever sends "Authorization: Bearer <this>" may read it; with no
# token the page does not exist. 24-200 characters from A-Z a-z 0-9 _ -
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# METRICS_TOKEN=
# Set to true only when a reverse proxy stands in front of the panel: the panel then takes the
# caller's address (for its rate limits) from X-Forwarded-For. Without a proxy, leave it unset.
# PANEL_TRUST_PROXY=true
